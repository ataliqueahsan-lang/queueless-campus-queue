rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'NONE';
    }
    function isStaff() { return role() in ['STAFF', 'ADMIN']; }
    function isAdmin() { return role() == 'ADMIN'; }

    // Clients may create student profiles, but may only change public profile fields.
    // Staff roles are assigned only by trusted server-side provisioning.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || (isStaff() && resource.data.role == 'STUDENT'));
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'studentId', 'email', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'studentId', 'email', 'role', 'createdAt'])
        && request.resource.data.role == 'STUDENT'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() >= 3
        && request.resource.data.studentId.size() <= 50
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.role == 'STUDENT'
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'studentId'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() >= 3
        && request.resource.data.studentId.size() <= 50;
      allow delete: if false;
    }

    // All operational writes go through authenticated callable Cloud Functions.
    match /services/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /queues/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /tokens/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow write: if false;
    }
    match /activeTokens/{lockId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }
    match /queue_events/{id} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
