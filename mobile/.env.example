# Copy to .env, fill from Firebase console > Project settings > Your apps > Web app.
# (Expo only exposes variables that start with EXPO_PUBLIC_.)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# true = built-in sample data, no Firebase needed. Also used automatically if the keys above are empty.
EXPO_PUBLIC_DEMO_MODE=false
